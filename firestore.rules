rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin list must stay aligned with lib/core/validators.dart (any casing in token is OK).
    // Case-insensitive match: Auth token email casing can differ from the allowlist.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.matches(
          '(?i)^(ehdaa\\.test|q\\.test|m\\.test|r\\.test)@admin\\.com$'
        );
    }

    // Own profile document: read anytime; create only for signup shape; update only safe fields.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.role is string
        && request.resource.data.createdAt is timestamp;

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username',
          'email',
          'phoneNumber',
          'gender',
          'nationality',
          'dateOfBirth',
          'profileImageUrl',
          'updatedAt',
          'name',
        ])
        && (!('role' in resource.data) || request.resource.data.role == resource.data.role)
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && (!('isAdmin' in resource.data) || request.resource.data.isAdmin == resource.data.isAdmin);

      allow update: if isAdmin()
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role']);

      allow delete: if false;
    }

    // Append-only: each time a journey is finished, a row is added (never deleted by replay).
    match /users/{userId}/journeyCompletionHistory/{historyId} {
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.journeyId is string;
      allow read: if isOwner(userId) || isAdmin();
      allow update, delete: if false;
    }

    // In-progress journey (map region + challenge flags). Deleted when the journey is completed.
    match /users/{userId}/activeJourneys/{journeyId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.journeyId == journeyId
        && request.resource.data.journeyTitle is string
        && request.resource.data.landmarksJourneyId is string
        && request.resource.data.currentRegion is int
        && request.resource.data.currentRegion >= 1
        && request.resource.data.currentRegion <= 50
        && request.resource.data.qubaChallengeCompleted is bool
        && request.resource.data.lastRegionChallengeCompleted is bool
        && (!('catalogJourneyId' in request.resource.data)
          || request.resource.data.catalogJourneyId == null
          || request.resource.data.catalogJourneyId is string);
      allow delete: if isOwner(userId);
    }

    // After feedback: user must pay again before starting. Cleared on successful payment.
    match /users/{userId}/journeyPurchaseGate/{journeyId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.requiresNewPurchase == true;
      allow delete: if isOwner(userId);
    }

    // Mirror of top-level `feedback` for profile (same fields + same doc id as `feedback/{id}`).
    match /users/{userId}/journeyFeedback/{feedbackId} {
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.journeyId is string
        && request.resource.data.overallRating is number
        && request.resource.data.overallRating >= 1
        && request.resource.data.overallRating <= 5
        && request.resource.data.get('contentRating', 0) is number
        && request.resource.data.get('contentRating', 0) >= 0
        && request.resource.data.get('contentRating', 0) <= 5
        && request.resource.data.get('recommendationRating', 0) is number
        && request.resource.data.get('recommendationRating', 0) >= 0
        && request.resource.data.get('recommendationRating', 0) <= 5
        && request.resource.data.get('challengeRating', 0) is number
        && request.resource.data.get('challengeRating', 0) >= 0
        && request.resource.data.get('challengeRating', 0) <= 5
        && (!('overallComment' in request.resource.data)
          || request.resource.data.overallComment is string)
        && (!('photos' in request.resource.data)
          || (request.resource.data.photos is list
            && request.resource.data.photos.size() <= 20));
      allow read: if isOwner(userId);
      allow update, delete: if false;
    }

    // Journey completion (1 doc id per user+journey: `{uid}_{journeyId}`).
    // Updates: [markCompleted] uses merge (treated as update). Deletes: replay after a new payment.
    match /journeyCompletions/{completionId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.journeyId is string;
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.journeyId == resource.data.journeyId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Feedback (multiple docs per user+journey allowed).
    // Optional detail ratings may be omitted by the client; treat missing as 0.
    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.journeyId is string
        && request.resource.data.overallRating is number
        && request.resource.data.overallRating >= 1
        && request.resource.data.overallRating <= 5
        && request.resource.data.get('contentRating', 0) is number
        && request.resource.data.get('contentRating', 0) >= 0
        && request.resource.data.get('contentRating', 0) <= 5
        && request.resource.data.get('recommendationRating', 0) is number
        && request.resource.data.get('recommendationRating', 0) >= 0
        && request.resource.data.get('recommendationRating', 0) <= 5
        && request.resource.data.get('challengeRating', 0) is number
        && request.resource.data.get('challengeRating', 0) >= 0
        && request.resource.data.get('challengeRating', 0) <= 5
        && (!('overallComment' in request.resource.data)
          || request.resource.data.overallComment is string)
        && (!('photos' in request.resource.data)
          || (request.resource.data.photos is list
            && request.resource.data.photos.size() <= 20));
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if isAdmin()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.journeyId == resource.data.journeyId
        && request.resource.data.overallRating == resource.data.overallRating
        && request.resource.data.get('contentRating', 0) == resource.data.get('contentRating', 0)
        && request.resource.data.get('recommendationRating', 0) == resource.data.get('recommendationRating', 0)
        && request.resource.data.get('challengeRating', 0) == resource.data.get('challengeRating', 0)
        && request.resource.data.get('overallComment', '') == resource.data.get('overallComment', '')
        && request.resource.data.get('photos', []) == resource.data.get('photos', [])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminResponses']);
      allow delete: if false;
    }
    // Optional user-uploaded gallery (profile "Your photos"). Not used by core journey flow.
    match /photos/{photoId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Legacy journey list for profile (if present in project data).
    match /user_journeys/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Curated recommendation places (FR-21/FR-22). Same visibility model as [journeys]:
    // public read so the map can load POIs even when Auth is not ready yet (e.g. post-payment flow).
    match /recommendation_places/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Optional alternate collection ids used by the client when migrating data.
    match /recommendations/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /recommended_places/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Journeys: anyone can read (browse), authenticated users can write
    match /journeys/{journeyId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Journey landmarks: editorial/map content. Public read (like [journeys]); writes admin-only.
    match /journey_landmarks/{landmarkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // FAQs: anyone can read, no client writes.
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if false;
    }
    // Orders: authenticated users can read/write
    match /orders/{orderId} {
      allow read, write: if isSignedIn();
    }
    // Payments: authenticated users can read/write
    match /payments/{paymentId} {
      allow read, write: if isSignedIn();
    }

    // Password reset codes — legacy; Admin SDK only
    match /password_reset_codes/{docId} {
      allow read, write: if false;
    }

    // Password reset OTP sessions — Admin SDK only (hashed OTP, never plain code)
    match /password_reset_otps/{docId} {
      allow read, write: if false;
    }

    // Public email index for password reset "exists" checks.
    // Stores only a hash of the normalized email to avoid exposing raw addresses.
    // Read is public so the reset flow can run while signed out.
    match /email_index/{emailHash} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }
  }
}
