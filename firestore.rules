rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Keep in sync with lib/core/validators.dart (_adminEmails).
    // Case-insensitive: Auth token email casing may differ from the allowlist.
    function isAdminEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.matches(
          '(?i)^(ehdaa\\.test|q\\.test|m\\.test|r\\.test|malak)@admin\\.com$'
        );
    }

    // Reads users/{uid}.role once. Does NOT recurse: rule-engine get() bypasses
    // security rules on the fetched document (no re-entry into match /users/...).
    function hasAdminRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Prefer email check first (no extra read). malak@admin.com OR users.role == admin.
    function isAdmin() {
      return isAdminEmail() || hasAdminRole();
    }

    function challengeRatingValue(data) {
      return data.get('challengeRating', data.get('challengerRating', 0));
    }

    function isValidFeedbackPayload(data) {
      return data.userId is string
        && data.journeyId is string
        && data.overallRating is number
        && data.overallRating >= 1
        && data.overallRating <= 5
        && data.get('contentRating', 0) is number
        && data.get('contentRating', 0) >= 0
        && data.get('contentRating', 0) <= 5
        && data.get('recommendationRating', 0) is number
        && data.get('recommendationRating', 0) >= 0
        && data.get('recommendationRating', 0) <= 5
        && challengeRatingValue(data) is number
        && challengeRatingValue(data) >= 0
        && challengeRatingValue(data) <= 5
        && (!('overallComment' in data) || data.overallComment is string)
        && (!('photos' in data)
          || (data.photos is list && data.photos.size() <= 20));
    }

    function feedbackUserContentUnchanged() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.journeyId == resource.data.journeyId
        && request.resource.data.overallRating == resource.data.overallRating
        && request.resource.data.get('contentRating', 0) == resource.data.get('contentRating', 0)
        && request.resource.data.get('recommendationRating', 0)
            == resource.data.get('recommendationRating', 0)
        && challengeRatingValue(request.resource.data) == challengeRatingValue(resource.data)
        && request.resource.data.get('overallComment', '')
            == resource.data.get('overallComment', '')
        && request.resource.data.get('photos', []) == resource.data.get('photos', [])
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isValidAdminFeedbackUpdate() {
      return isAdmin()
        && feedbackUserContentUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['adminResponses', 'adminResponse', 'respondedAt'])
        && (!('adminResponse' in request.resource.data)
          || request.resource.data.adminResponse is string)
        && (!('respondedAt' in request.resource.data)
          || request.resource.data.respondedAt is timestamp)
        && (!('adminResponses' in request.resource.data)
          || request.resource.data.adminResponses is list);
    }

    function ownsOrder(orderId) {
      return isSignedIn()
        && orderId is string
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId)).data.userId
            == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // users — profile + nested journey data (instance-scoped history/memories)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Signup: only user role unless email is on the admin allowlist.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.role is string
        && request.resource.data.createdAt is timestamp
        && (
          request.resource.data.role == 'user'
          || (isAdminEmail() && request.resource.data.role == 'admin')
        );

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username',
          'email',
          'phoneNumber',
          'gender',
          'nationality',
          'dateOfBirth',
          'profileImageUrl',
          'updatedAt',
          'name',
        ])
        && (!('role' in resource.data) || request.resource.data.role == resource.data.role)
        && (!('createdAt' in resource.data)
          || request.resource.data.createdAt == resource.data.createdAt)
        && (!('isAdmin' in resource.data)
          || request.resource.data.isAdmin == resource.data.isAdmin);

      // Admin audit: change name/role; email and createdAt are immutable.
      allow update: if isAdmin()
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role']);

      allow delete: if false;

      match /journeyCompletionHistory/{historyId} {
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.journeyId is string;
        allow read: if isOwner(userId) || isAdmin();
        allow update, delete: if false;
      }

      match /activeJourneys/{journeyId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.journeyId is string
          && request.resource.data.journeyTitle is string
          && request.resource.data.landmarksJourneyId is string
          && request.resource.data.currentRegion is int
          && request.resource.data.currentRegion >= 1
          && request.resource.data.currentRegion <= 50
          && request.resource.data.qubaChallengeCompleted is bool
          && request.resource.data.lastRegionChallengeCompleted is bool
          && (!('catalogJourneyId' in request.resource.data)
            || request.resource.data.catalogJourneyId == null
            || request.resource.data.catalogJourneyId is string);
        allow delete: if isOwner(userId);
      }

      // [historyDocId] is catalog id (legacy) or playthrough instance id (userJourneyId).
      match /journeyHistory/{historyDocId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.journeyId is string
          && (
            request.resource.data.journeyId == historyDocId
            || (request.resource.data.userJourneyId is string
              && request.resource.data.userJourneyId == historyDocId)
          );
        allow update: if isOwner(userId);
        allow delete: if false;

        match /landmarkMemories/{memoryId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId)
            && request.resource.data.userId == userId
            && request.resource.data.landmarkId is string
            && (request.resource.data.landmarkTitle is string
              || request.resource.data.landmarkName is string)
            && (request.resource.data.landmarkOrder is int
              || request.resource.data.landmarkOrder is float)
            && request.resource.data.mediaUrl is string
            && request.resource.data.mediaType is string
            && request.resource.data.storagePath is string
            && request.resource.data.createdAt is timestamp
            && (
              request.resource.data.journeyId == historyDocId
              || (request.resource.data.userJourneyId is string
                && request.resource.data.userJourneyId == historyDocId)
            );
          allow update, delete: if false;
        }
      }

      match /journeyPurchaseGate/{journeyId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.requiresNewPurchase == true;
        allow delete: if isOwner(userId);
      }

      match /journeyFeedback/{feedbackId} {
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && isValidFeedbackPayload(request.resource.data);
        allow read: if isOwner(userId);
        allow update, delete: if false;
      }
    }

    // -------------------------------------------------------------------------
    // journeyCompletions — user progress; admins read for dashboard analytics
    // -------------------------------------------------------------------------
    match /journeyCompletions/{completionId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.journeyId is string;
      allow read: if isAdmin()
        || (isSignedIn()
          && (resource == null || resource.data.userId == request.auth.uid));
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.journeyId == resource.data.journeyId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // feedback — users create; admins reply (adminResponse / respondedAt / history)
    // -------------------------------------------------------------------------
    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isValidFeedbackPayload(request.resource.data);

      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid)
        || isAdmin();

      allow update: if isValidAdminFeedbackUpdate();

      allow delete: if false;
    }

    match /photos/{photoId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /user_journeys/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Places / recommendations — public read; admin CRUD (dashboard Places tab)
    // -------------------------------------------------------------------------
    match /recommendations/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /recommendation_places/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /recommended_places/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Journey catalog — public browse; admin-only writes (dashboard Journeys tab)
    // -------------------------------------------------------------------------
    match /journeys/{journeyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /journey_landmarks/{landmarkId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Commerce — scoped to order owner (+ admin read).
    // -------------------------------------------------------------------------
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (isSignedIn() && ownsOrder(resource.data.orderId));
      allow create: if isSignedIn()
        && request.resource.data.orderId is string
        && ownsOrder(request.resource.data.orderId);
      allow update: if isAdmin()
        || (isSignedIn()
          && ownsOrder(resource.data.orderId)
          && request.resource.data.orderId == resource.data.orderId);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Server-only / public index
    // -------------------------------------------------------------------------
    match /password_reset_codes/{docId} {
      allow read, write: if false;
    }

    match /password_reset_otps/{docId} {
      allow read, write: if false;
    }

    // Collection-group reads for profile landmark photos (indexed userId + userJourneyId).
    match /{path=**}/landmarkMemories/{memoryId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /email_index/{emailHash} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }
  }
}
