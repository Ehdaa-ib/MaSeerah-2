# Copy to .env for local emulator / deploy. Never commit .env — it is gitignored.
#
# Production: set the same variables on each Cloud Run email service, or deploy with this .env file.
#
# Test locally: node scripts/test-smtp.js recipient@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password-16-chars
SMTP_FROM=you@gmail.com
