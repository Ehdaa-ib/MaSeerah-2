rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Feedback photos are uploaded to:
    // feedbackPhotos/{userId}/{journeyId}/{filename}
    match /feedbackPhotos/{userId}/{journeyId}/{fileName} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}

